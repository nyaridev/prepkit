{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrepKit",
  "version": "0.1.0",
  "identifier": "com.nyaridev.prepkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4390",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrepKit",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
